# Used by docker compose. Copy to .env and fill in the secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public URL of the store (used for CORS, email links and canonical URLs)
CLIENT_URL=http://localhost:8080
SERVER_URL=http://localhost:8080
FRONTEND_PORT=8080
# Leave empty to use secure cookies (works on https:// and http://localhost).
# Set to false only when serving plain HTTP on another host.
COOKIE_SECURE=

# Payments: cod,razorpay,stripe. A gateway is offered only when its keys are set.
PAYMENT_PROVIDERS=cod,razorpay,stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (empty SMTP_HOST = emails are logged, not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ShopSphere <no-reply@shopsphere.local>

# Storage: LOCAL | S3 | CLOUDINARY
STORAGE_PROVIDER=LOCAL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_PUBLIC_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
